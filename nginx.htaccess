# ============================================================
# 宝塔 Nginx 安全配置（直接粘贴，无需 include 外部文件）
#
# 操作：宝塔面板 → 网站 → lib.crayon.vip → 设置 → 配置文件
# 在 server { ... } 内粘贴下方「安全规则」块即可
# 若与现有 location 重复，保留一份，注释掉旧的
#
# PHP 8.3 请确认 fastcgi_pass 为：unix:/tmp/php-cgi-83.sock
# ============================================================


# ---------- 以下整段复制到 server {} 内 ----------

# 安全响应头
add_header X-Frame-Options "SAMEORIGIN" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-XSS-Protection "1; mode=block" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;

# 禁止访问敏感目录/文件
location ~ /\.(git|svn|env|htaccess|user\.ini) {
    deny all;
}

location ~* \.(sql|bak|log|sh)$ {
    deny all;
}

location ^~ /config/ {
    deny all;
}

location ^~ /session/ {
    deny all;
}

location ^~ /scripts/security_reports/ {
    deny all;
}

location = /library.sql {
    deny all;
}

location ~ ^/library_.*\.sql$ {
    deny all;
}

location = /plugins/phpqrcode/index.php {
    deny all;
}

# 拦截 WordPress 扫描
location ~* /wp-includes/|/wp-admin/|wlwmanifest\.xml {
    return 444;
}

# upload 目录禁止执行 PHP
location ^~ /upload/ {
    location ~ \.(php|phtml|php3|php4|php5|phar|htaccess|user\.ini)$ {
        deny all;
    }
    try_files $uri =404;
}

# PHP 处理（若站点已有 location ~ \.php$，只需把 upload 兜底规则合并进去）
location ~ \.php$ {
    if ($uri ~* "^/upload/.*\.(php|phtml|phar)$") {
        return 403;
    }
    include snippets/fastcgi-php.conf;
    fastcgi_index index.php;
    fastcgi_pass unix:/tmp/php-cgi-83.sock;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    include fastcgi_params;
}

# ---------- 粘贴结束 ----------
